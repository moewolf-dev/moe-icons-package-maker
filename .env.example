# moe-icons-package-maker environment configuration
# Copy to `.env` and fill in values for your mode. Never commit real values.
# All variables are optional for the local core; required per mode at startup.

# --- Local / Node CLI mode ---
# Catalog JSON path (relative or absolute)
MAKER_CATALOG_PATH=data/icon-catalog.json

# Default SVG source directory (files keyed by canonical icon id, e.g. <id>.svg)
MAKER_SVG_DIR=uploads/

# Default output directory for ZIP + generated files
MAKER_OUTPUT_DIR=out/

# Maximum accepted SVG byte size (default 2MB)
MAKER_MAX_SVG_BYTES=2097152

# --- GitHub Action / remote mode (secret values go in repo secrets, not .env) ---
# Target repository for PR submission, e.g. moewolf-dev/moe-icons-code-library
# MAKER_TARGET_REPO=
# Base branch for PRs, e.g. main
# MAKER_TARGET_BRANCH=main
# Incoming SVG directory inside the target repo, e.g. icons/<style>
# MAKER_TARGET_DIR=icons

# --- R2 (Cloudflare) publication (secrets in CI) ---
# MAKER_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MAKER_R2_BUCKET=moe-icons-user-groups
# MAKER_R2_PUBLIC_BASE_URL=https://assets.moeicons.com

# --- Auth / GitHub identity (never commit tokens) ---
# MAKER_GITHUB_REPOSITORY=moewolf-dev/moe-icons-package-maker
# MAKER_GITHUB_TOKEN=<secret>          # set in GitHub Actions secrets only
# MAKER_AUTH0_DOMAIN=<tenant>.auth0.com
# MAKER_AUTH0_AUDIENCE=https://api.moeicons.com
