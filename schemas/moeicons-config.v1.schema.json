{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.moeicons.dev/moeicons-config/v1.schema.json",
  "title": "MoeiconsConfig",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "framework",
    "outputDir",
    "defaultTheme",
    "themes",
    "icons"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "framework": { "enum": ["react", "vue"] },
    "outputDir": { "type": "string", "minLength": 1 },
    "defaultTheme": { "type": "string", "minLength": 1 },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["styles"],
        "properties": {
          "styles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "defaultSize": { "type": "integer", "minimum": 1 },
          "strokeWidth": { "type": "number", "minimum": 0 },
          "className": { "type": "string" }
        }
      }
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
    },
    "missingIconPolicy": { "enum": ["fallback", "error"] }
  }
}
