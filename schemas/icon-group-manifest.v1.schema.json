{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.moeicons.dev/icon-group-manifest/v1.schema.json",
  "title": "IconGroupManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groupId",
    "displayName",
    "styleId",
    "author",
    "createdWith",
    "createdAt",
    "entries",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groupId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "styleId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "source": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "createdWith": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iconId", "subgroupId", "outputPath", "checksum"],
        "properties": {
          "iconId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "subgroupId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "outputPath": {
            "type": "string",
            "pattern": "^(?!.*\\.\\./)[a-z0-9/_-]+\\.svg$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "filled", "valid", "warnings", "errors", "missing"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "filled": { "type": "integer", "minimum": 0 },
        "valid": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
