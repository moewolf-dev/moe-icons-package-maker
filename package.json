{
  "name": "moe-icons-package-maker",
  "version": "0.1.0",
  "type": "module",
  "description": "Moeicons online visual package maker: catalog, mapping, validation, deterministic ZIP, and submission adapters.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/browser.d.ts",
      "import": "./dist/catalog/browser.js",
      "browser": "./dist/catalog/browser.js"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:dev": "npm run dev",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "serve": "vite-node src/cli/serve-bin.ts",
    "catalog:generate": "vite-node scripts/generate-catalog.mts",
    "catalog:reconcile": "vite-node src/catalog/reconcile.ts",
    "format": "prettier --write src tests"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.11",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
